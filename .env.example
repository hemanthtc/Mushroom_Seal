# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
# mongodb+srv://<username>:<password>@cluster0.mongodb.net/mushroom_seal?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mushroom_seal

# JWT Secret Key for signing Customer and Seller authentication tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_32char_min

# OTP Expiry in Seconds (5 minutes)
OTP_EXPIRY_SECONDS=300
