# Server Port
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=development

# MongoDB Connections
# Replace with your actual MongoDB Atlas cluster credentials and cluster URL:
# Example: MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/mushroom_seal?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mushroom_seal?retryWrites=true&w=majority

# FastAPI Python Backend Connection URL and DB Name
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-url>/
DB_NAME=mushroom_seal

# JWT Secret Key for signing Customer and Seller authentication tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_32char_min

# OTP Expiry in Seconds (5 minutes)
OTP_EXPIRY_SECONDS=300
